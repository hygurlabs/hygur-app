{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hygur",
  "version": "0.4.0",
  "identifier": "com.hygur.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hygur"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hygur",
        "width": 1100,
        "height": 900,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8420 http://localhost:8420 https://console.hygur.ai https://cloud.hygur.ai https://*.hygur.ai https://*.hygur.eu; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Your local digital twin",
    "longDescription": "A private memory of your documents, mail and notes, powered by your own LLM. Runs entirely on your machine.",
    "externalBin": ["binaries/hygur-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
